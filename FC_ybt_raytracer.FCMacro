# -*- coding: utf-8 -*-
"""
FC_ybt_raytracer.FCMacro -- ince başlatıcı
FreeCAD içinde yerleşik numpy ışın izleyici. Asıl kod `ybt_raytracer/` paketindedir; bu dosya yalnızca paketi bulup
ayar panelini açar (eklenti komutu YBT_Render ile aynı iş).
Eklenti olarak kurulduysa (Mod/ klasörü; Init.py / InitGui.py) komutlar Macro araç çubuğunda ve menüsünde zaten vardır;
bu makro, eklentisiz (makro klasörüne kopyalanmış) kullanım içindir. Bu dosya ve paket klasörü AYNI yerde durmalıdır.
Kullanım: Macro > Macros... > bu dosyayı çalıştır.
"""
import os
import sys
import importlib

def _find_here():
    """Başlatıcının klasörü: ybt_raytracer/ paketi bu klasörde olmalı."""
    cands = []
    try:
        cands.append(os.path.dirname(os.path.abspath(__file__)))
    except NameError:
        pass
    try:
        cands.append(os.path.dirname(os.path.abspath(sys._getframe().f_code.co_filename)))
    except Exception:
        pass
    try:
        import FreeCAD
        cands.append(FreeCAD.getUserMacroDir(True))
        cands.append(FreeCAD.ParamGet("User parameter:BaseApp/Preferences/Macro").GetString("MacroPath", ""))
    except Exception:
        pass
    try:                                # Addon Manager depoyu Mod/ altına da koyabilir
        import FreeCAD
        for base in (FreeCAD.getUserAppDataDir(), FreeCAD.getHomePath()):
            moddir = os.path.join(base, "Mod")
            if os.path.isdir(moddir):
                for sub in sorted(os.listdir(moddir)):
                    cands.append(os.path.join(moddir, sub))
    except Exception:
        pass
    for c in cands:
        if c and os.path.isdir(os.path.join(c, "ybt_raytracer")):
            return c
    raise RuntimeError("ybt_raytracer/ klasörü başlatıcı makroyla aynı yerde bulunamadı. Denenen: %s" % cands)


_HERE = _find_here()
if _HERE not in sys.path:
    sys.path.insert(0, _HERE)

# makro tekrar çalıştırılınca güncel kodu yükle (FreeCAD'i yeniden başlatmadan)
for _m in [m for m in list(sys.modules) if m == "ybt_raytracer" or m.startswith("ybt_raytracer.")]:
    del sys.modules[_m]

try:
    import FreeCADGui  # noqa: F401
    _IN_FREECAD = True
except ImportError:
    _IN_FREECAD = False

if _IN_FREECAD:
    from ybt_raytracer.ui import main
    main()
